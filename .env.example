ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama needs no API key — just a local server. Both optional, shown defaults below.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ADMIN_TOKEN=1234
# Confirmed project workspace root — defaults to ./workspace under the repo if unset.
WORKSPACE_ROOT_PATH=
# Firebase App Distribution — set via the admin panel's Firebase section.
FIREBASE_APP_ID=
FIREBASE_CI_TOKEN=
FIREBASE_TESTER_GROUPS=
FIREBASE_RELEASE_NOTES=
# Extra hosts allowed to call this server (CORS) — a phone on Tailscale, an
# ngrok tunnel, etc. Comma-separated. Include :8080 for direct LAN/Tailscale
# access (http://host:8080) — omit the port for Tailscale Funnel/HTTPS access
# (https://host), which strips the port before it ever reaches this server.
# Editable from the admin panel's "Dev server allowed hosts" section, but a
# new entry needs a chat-gateway restart to take effect (see HTTP.kt).
ALLOWED_HOSTS=
