<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{25} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- No config here means logback defaults to DEBUG, which floods a
         packaged jar's console with Netty internals a non-technical user
         never wants to see. INFO is the readable default. -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="io.netty" level="WARN" />
</configuration>
