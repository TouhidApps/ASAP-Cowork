# Optional — leave unset to use the Vite dev proxy (same-origin ws://<host>/ws/chat).
# VITE_WS_URL=ws://localhost:8081/ws/chat
# VITE_API_BASE_URL=http://localhost:8081

# Hostnames Vite's dev server accepts (Host header allowlist, Vite 5+) —
# comma-separated. Editable from the admin panel's Settings page instead of
# hand-editing this file.
VITE_ALLOWED_HOSTS=
